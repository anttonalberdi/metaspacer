{
  "name": "metaspacer",
  "version": "0.1.0",
  "private": true,
  "description": "Model and explore metagenomic spaces with explicit uncertainty and extrapolation tiers.",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "pnpm generate:fixtures && pnpm generate:types",
    "generate:fixtures": "Rscript scripts/generate-golden-data.R && node scripts/generate-golden-contracts.mjs",
    "generate:types": "node scripts/generate-types.mjs",
    "validate:bundle": "node scripts/validate-results-bundle.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && Rscript -e \"lints <- c(lintr::lint_dir('scripts'), lintr::lint_package('rpkg')); print(lints); quit(status = length(lints))\"",
    "test": "node --test tests/*.test.mjs && pnpm --filter @metaspacer/app test",
    "typecheck": "pnpm --filter @metaspacer/app typecheck",
    "dev:app": "pnpm --filter @metaspacer/app dev",
    "build:app": "pnpm --filter @metaspacer/app build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "eslint": "^10.0.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
